{
  "name": "zerops-astrobranding",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "bun scripts/bootstrap.mjs",
    "dev": "bun --filter astrobranding dev",
    "dev:website": "bun --filter @astrobranding/website dev",
    "dev:webapp": "bun --filter @astrobranding/webapp dev",
    "build": "bun --filter '*' build",
    "build:api": "bun --filter astrobranding build",
    "build:website": "bun --filter @astrobranding/website build",
    "build:webapp": "bun --filter @astrobranding/webapp build",
    "start": "bun --filter astrobranding start",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
