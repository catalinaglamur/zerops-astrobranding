{
  "name": "zerops-astrobranding",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "./setup.sh",
    "bootstrap": "bun scripts/bootstrap.mjs",
    "dev": "bun --filter @astrobranding/astrobranding dev",
    "build": "bun --filter '*' build",
    "start": "bun --filter @astrobranding/astrobranding start",
    "check": "tsc --noEmit",
    "check:arch": "bun scripts/architecture-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
