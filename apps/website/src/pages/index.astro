---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Zerops AstroBranding — Plataforma Soberana de Inteligencia y Astrología de Negocios">
  <main style="max-width: 900px; margin: 0 auto; padding: 4rem 1.5rem;">
    <header style="text-align: center; margin-bottom: 4rem;">
      <div style="display: inline-block; padding: 0.25rem 0.75rem; background: rgba(88, 166, 255, 0.1); border: 1px solid rgba(88, 166, 255, 0.3); border-radius: 9999px; color: #58a6ff; font-size: 0.875rem; margin-bottom: 1.5rem;">
        Malla Soberana de 10 Servicios en Zerops
      </div>
      <h1 style="font-size: 3rem; font-weight: 800; letter-spacing: -0.05em; line-height: 1.1; margin-bottom: 1.5rem; background: linear-gradient(135deg, #fff 0%, #8b949e 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        AstroBranding & AI Sovereignty
      </h1>
      <p style="font-size: 1.25rem; color: #8b949e; max-width: 650px; margin: 0 auto 2rem;">
        Arquitectura unificada que fusiona diagnóstico astrológico multidimensional, orquestación de IA con Maxim Bifrost y mensajería en tiempo real con EvolutionGo.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center;">
        <a href="/app" style="display: inline-block; background: #238636; color: #fff; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: 600;">
          Abrir Cockpit de Cliente
        </a>
        <a href="/docs" style="display: inline-block; background: #21262d; border: 1px solid #30363d; color: #c9d1d9; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: 600;">
          Ver Documentación
        </a>
      </div>
    </header>

    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-bottom: 4rem;">
      <div style="background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 1.5rem;">
        <h3 style="color: #58a6ff; margin-top: 0;">Motor Astrológico SOTA</h3>
        <p style="color: #8b949e; font-size: 0.95rem;">Cálculo determinista con sistemas tropicales y siderales, domificación personalizada y extracción de arquetipos.</p>
      </div>
      <div style="background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 1.5rem;">
        <h3 style="color: #3fb950; margin-top: 0;">Bifrost + FreeLLMAPI</h3>
        <p style="color: #8b949e; font-size: 0.95rem;">Enrutamiento CEL inteligente y caché semántica en Valkey 7.2 con respaldo de 34+ proveedores de IA gratuitos.</p>
      </div>
      <div style="background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 1.5rem;">
        <h3 style="color: #f0883e; margin-top: 0;">PostgreSQL 18 + pgvector</h3>
        <p style="color: #8b949e; font-size: 0.95rem;">Persistencia relacional con UUIDv7 nativo y búsqueda semántica vectorial acelerada por índices HNSW.</p>
      </div>
    </section>

    <footer style="text-align: center; border-top: 1px solid #21262d; padding-top: 2rem; color: #484f58; font-size: 0.875rem;">
      Zerops Sovereign Mesh &copy; {new Date().getFullYear()} — Desplegado en Incus LXC Containers
    </footer>
  </main>
</Layout>
