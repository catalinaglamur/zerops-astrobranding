---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Checkout Soberano — AstroBranding">
  <div class="max-w-3xl mx-auto px-6 py-16 font-sans" id="checkoutApp">
    <a href="/" class="text-xs text-neutral-500 hover:text-neutral-300 font-mono mb-8 inline-block">← Volver al inicio</a>

    <header class="mb-10 text-center">
      <span class="text-xs uppercase tracking-widest text-indigo-400 font-bold">Checkout Multi-Pasarela Soberano</span>
      <h1 class="text-3xl font-extrabold tracking-tight mt-1 text-white">Desbloqueá tu Dossier Arquetípico Completo</h1>
      <p class="text-neutral-400 text-sm mt-2">
        Modelo Pay-What-You-Want ($1+ USD). Seleccioná tu medio de pago preferido con liquidación y facturación automática.
      </p>
    </header>

    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 space-y-8 shadow-xl">
      <!-- Oferta Principal (Front-end $1+) -->
      <div class="border-b border-neutral-800 pb-6">
        <div class="flex justify-between items-start">
          <div>
            <span class="text-xs bg-indigo-950 text-indigo-300 px-2 py-0.5 rounded border border-indigo-800/40 font-semibold">Oferta Principal</span>
            <h3 class="text-lg font-bold text-white mt-2">Dossier AstroBranding Tropical + Sideral (Shards 01 a 15)</h3>
            <p class="text-xs text-neutral-400 mt-1">24 sistemas de casas, domificación Campanus, Jyotish D10, BaZi y Cábala Tikkun.</p>
          </div>
          <div class="text-right">
            <span class="text-xs text-neutral-500 block line-through">$47 USD</span>
            <span class="text-lg font-extrabold text-indigo-400">Pago Libre ($1+)</span>
          </div>
        </div>
      </div>

      <!-- Order Bump -->
      <div class="bg-neutral-950/80 border-2 border-dashed border-amber-500/40 rounded-xl p-5 space-y-2">
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" id="orderBumpCheckbox" class="mt-1 w-4 h-4 rounded text-amber-500 bg-neutral-900 border-neutral-700" />
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">Order Bump Recomendado</span>
              <span class="text-xs bg-amber-950 text-amber-300 px-1.5 py-0.5 rounded font-mono">+$7 USD</span>
            </div>
            <p class="text-sm font-bold text-white mt-1">Desglose Vocacional Védico Jyotish D10 Dasamsa + Shadbala (Shard 03)</p>
            <p class="text-xs text-neutral-400 mt-0.5">
              Calcula tus Casas de Riqueza (Artha), Nakshatras predominantes y los 6 factores de fuerza planetaria para maximizar ingresos.
            </p>
          </div>
        </label>
      </div>

      <!-- Upsell Preview -->
      <div class="bg-neutral-950/40 border border-neutral-800 rounded-xl p-5">
        <div class="flex justify-between items-center text-xs">
          <span class="text-neutral-400">1-Click Upsell Posterior:</span>
          <span class="text-indigo-300 font-semibold">BaZi 4 Pilares + Cábala Tikkun Rav Berg (+$19 USD)</span>
        </div>
      </div>

      <!-- Downsell Preview -->
      <div class="bg-neutral-950/40 border border-neutral-800 rounded-xl p-5">
        <div class="flex justify-between items-center text-xs">
          <span class="text-neutral-400">Downsell Estratégico:</span>
          <span class="text-emerald-300 font-semibold">Sesión Clínica 1 a 1 con el Coach ($150 USD)</span>
        </div>
      </div>

      <!-- Formulario de Checkout Multi-Pasarela -->
      <form id="checkoutForm" class="space-y-6 pt-2">
        <!-- Aporte Base -->
        <div>
          <label for="baseAmount" class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-1">
            Tu Aporte Base (USD):
          </label>
          <div class="relative">
            <span class="absolute left-4 top-2.5 text-neutral-500 font-bold">$</span>
            <input
              type="number"
              id="baseAmount"
              name="baseAmount"
              min="1"
              value="5"
              step="1"
              required
              class="w-full bg-neutral-950 border border-neutral-800 rounded-lg pl-8 pr-4 py-2.5 text-sm text-white font-bold focus:outline-none focus:border-indigo-500 transition-colors"
            />
          </div>
        </div>

        <!-- Selector Dinámico de Pasarela de Pago -->
        <div>
          <label class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-2">
            Medio de Pago Disponible:
          </label>
          <div id="gatewaysContainer" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="text-xs text-neutral-500 p-4 border border-neutral-800 rounded-xl text-center col-span-3">
              Detectando pasarelas activas...
            </div>
          </div>
        </div>

        <!-- Resumen Total -->
        <div class="bg-neutral-950 border border-neutral-800 rounded-xl p-4 flex justify-between items-center">
          <span class="text-sm font-semibold text-neutral-300">Total a Liquidar:</span>
          <span id="totalDisplay" class="text-xl font-extrabold text-indigo-400">$5.00 USD</span>
        </div>

        <div id="paymentFeedback" class="hidden text-xs p-3 rounded-lg"></div>

        <button
          type="submit"
          id="payButton"
          class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-400 font-bold text-sm text-white transition-all shadow-lg shadow-indigo-600/25 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Pagar Ahora & Activar Reporte →
        </button>
      </form>
    </div>
  </div>

  <script>
    interface GatewayInfo {
      id: "dlocalgo" | "wompi" | "epayco" | "stripe" | "mercadopago";
      name: string;
      currencies: string[];
      supportedMethods: string[];
      isDefault: boolean;
    }

    let activeGateways: GatewayInfo[] = [];
    let selectedGateway: "dlocalgo" | "wompi" | "epayco" | "stripe" | "mercadopago" = "stripe";

    const baseAmountInput = document.getElementById("baseAmount") as HTMLInputElement;
    const orderBumpCheckbox = document.getElementById("orderBumpCheckbox") as HTMLInputElement;
    const totalDisplay = document.getElementById("totalDisplay") as HTMLElement;
    const gatewaysContainer = document.getElementById("gatewaysContainer") as HTMLElement;
    const checkoutForm = document.getElementById("checkoutForm") as HTMLFormElement;
    const payButton = document.getElementById("payButton") as HTMLButtonElement;
    const feedback = document.getElementById("paymentFeedback") as HTMLElement;

    function calculateTotal(): number {
      const base = Math.max(1, parseFloat(baseAmountInput.value) || 1);
      const bump = orderBumpCheckbox.checked ? 7 : 0;
      return base + bump;
    }

    function updateTotal(): void {
      const total = calculateTotal();
      totalDisplay.textContent = `$${total.toFixed(2)} USD`;
    }

    baseAmountInput.addEventListener("input", updateTotal);
    orderBumpCheckbox.addEventListener("change", updateTotal);

    async function loadGateways(): Promise<void> {
      try {
        const res = await fetch("/api/v1/payments/gateways");
        if (!res.ok) throw new Error("Error consultando pasarelas");
        const data = await res.json() as { gateways: GatewayInfo[]; defaultGateway?: "dlocalgo" | "wompi" | "epayco" | "stripe" | "mercadopago" };
        activeGateways = data.gateways;

        if (activeGateways.length === 0) {
          activeGateways = [
            { id: "stripe", name: "Stripe (Apple Pay & Tarjetas)", currencies: ["USD", "EUR"], supportedMethods: ["cards", "apple_pay", "google_pay"], isDefault: true },
            { id: "dlocalgo", name: "dLocal Go (LatAm & Tarjetas)", currencies: ["USD", "COP"], supportedMethods: ["cards", "pse"], isDefault: false },
          ];
        }

        selectedGateway = data.defaultGateway || activeGateways[0].id;
        renderGateways();
      } catch (err) {
        console.warn("[Payments] Fallback local para pasarelas:", err);
        activeGateways = [
          { id: "stripe", name: "Stripe (Apple Pay)", currencies: ["USD"], supportedMethods: ["cards", "apple_pay"], isDefault: true },
          { id: "dlocalgo", name: "dLocal Go", currencies: ["USD"], supportedMethods: ["cards"], isDefault: false },
          { id: "wompi", name: "Wompi (Bancolombia/PSE)", currencies: ["COP"], supportedMethods: ["pse", "bancolombia"], isDefault: false },
          { id: "epayco", name: "ePayco (DaviPlata/PSE)", currencies: ["COP", "USD"], supportedMethods: ["pse", "daviplata"], isDefault: false },
          { id: "mercadopago", name: "Mercado Pago (Pix/PSE)", currencies: ["COP", "BRL", "MXN"], supportedMethods: ["pix", "cards"], isDefault: false },
        ];
        selectedGateway = "stripe";
        renderGateways();
      }
    }

    function renderGateways(): void {
      gatewaysContainer.innerHTML = activeGateways.map((gw) => `
        <label class="cursor-pointer border rounded-xl p-3 flex flex-col justify-between transition-all ${
          selectedGateway === gw.id ? 'border-indigo-500 bg-indigo-950/30' : 'border-neutral-800 bg-neutral-950 hover:border-neutral-700'
        }">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-white">${gw.name}</span>
            <input type="radio" name="gatewayRadio" value="${gw.id}" ${selectedGateway === gw.id ? 'checked' : ''} class="w-3.5 h-3.5 text-indigo-600 bg-neutral-900 border-neutral-700" />
          </div>
          <span class="text-[10px] text-neutral-400 mt-2 font-mono">${gw.supportedMethods.join(", ")}</span>
        </label>
      `).join("");

      const radios = gatewaysContainer.querySelectorAll<HTMLInputElement>("input[name='gatewayRadio']");
      radios.forEach((radio) => {
        radio.addEventListener("change", (e) => {
          selectedGateway = (e.target as HTMLInputElement).value as any;
          renderGateways();
        });
      });
    }

    checkoutForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      payButton.disabled = true;
      payButton.textContent = "Procesando pago seguro...";
      feedback.className = "hidden text-xs p-3 rounded-lg";

      const total = calculateTotal();
      let clientId = localStorage.getItem("astrobranding_client_id");

      // Si no existe clientId previo en sesión, creamos uno efímero
      if (!clientId) {
        clientId = "00000000-0000-0000-0000-000000000001";
      }

      try {
        const res = await fetch("/api/v1/payments/create-session", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            clientId,
            amount: total,
            currency: "USD",
            gateway: selectedGateway,
            tier: orderBumpCheckbox.checked ? "order_bump_d10" : "basic_report",
            redirectUrl: window.location.origin + "/desk",
          }),
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || "No se pudo iniciar la sesión de pago");
        }

        feedback.className = "block bg-emerald-950/60 border border-emerald-800 text-emerald-300 text-xs p-3 rounded-lg";
        feedback.textContent = "¡Sesión creada! Redirigiendo a pasarela...";

        setTimeout(() => {
          if (data.redirectUrl) {
            window.location.href = data.redirectUrl;
          }
        }, 800);
      } catch (err: unknown) {
        payButton.disabled = false;
        payButton.textContent = "Pagar Ahora & Activar Reporte →";
        feedback.className = "block bg-red-950/60 border border-red-800 text-red-300 text-xs p-3 rounded-lg";
        feedback.textContent = err instanceof Error ? err.message : "Error al procesar pago";
      }
    });

    loadGateways();
    updateTotal();
  </script>
</BaseLayout>
