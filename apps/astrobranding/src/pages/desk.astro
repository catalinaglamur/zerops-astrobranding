---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CoachDeskApp } from "../components/desk/CoachDeskApp";

// Protection checkpoint: verify COACH_MASTER_KEY or session cookie
const masterKeyCookie = Astro.cookies.get("coach_session")?.value;
const isAuthorized = !!masterKeyCookie || import.meta.env.DEV;
---

<BaseLayout title="Cockpit Clínico del Coach — AstroBranding">
  {
    isAuthorized ? (
      <CoachDeskApp client:only="react" />
    ) : (
      <div class="min-h-screen flex items-center justify-center bg-neutral-950 p-6 font-mono">
        <div class="max-w-md w-full bg-neutral-900 border border-neutral-800 rounded-xl p-8 text-center space-y-4">
          <span class="w-3 h-3 rounded-full bg-rose-500 inline-block"></span>
          <h2 class="text-lg font-bold text-white">Gabinete Privado del Coach</h2>
          <p class="text-xs text-neutral-400">Ingresá tu clave maestra para acceder a los perfiles estratégicos de clientes.</p>
          <form method="POST" action="/api/coach/auth" class="space-y-3 pt-2">
            <input
              type="password"
              name="masterKey"
              placeholder="COACH_MASTER_KEY"
              required
              class="w-full bg-neutral-950 border border-neutral-800 rounded-lg px-4 py-2 text-xs text-white text-center focus:outline-none focus:border-emerald-500"
            />
            <button
              type="submit"
              class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-xs font-bold text-white rounded-lg transition-colors cursor-pointer"
            >
              Autenticar Gabinete
            </button>
          </form>
        </div>
      </div>
    )
  }
</BaseLayout>
