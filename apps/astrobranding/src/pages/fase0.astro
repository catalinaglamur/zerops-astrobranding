---
import BaseLayout from "../layouts/BaseLayout.astro";

const masterKeyCookie = Astro.cookies.get("coach_session")?.value;
const isAuthorized = !!masterKeyCookie || import.meta.env.DEV;
---

<BaseLayout title="Fase 0 — Constitución Ontológica del Autor">
  {
    isAuthorized ? (
      <div class="min-h-screen bg-neutral-950 text-neutral-100 font-sans p-6 sm:p-10 space-y-8 max-w-7xl mx-auto">
        {/* Header Banner */}
        <header class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-neutral-800">
          <div>
            <span class="text-[11px] font-mono font-bold tracking-widest text-amber-500 uppercase">Gabinete Clínico &middot; Fase 0</span>
            <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight mt-1">Constitución Ontológica del Autor</h1>
            <p class="text-xs text-neutral-400 mt-1">Dossier de autoridad arquetípica, Lakehouse de 15 Shards y Proyección de Feeds Gold.</p>
          </div>
          <div class="flex items-center gap-2">
            <a href="/desk" class="px-3 py-1.5 rounded-lg border border-neutral-800 bg-neutral-900 text-xs font-semibold hover:border-neutral-700 text-neutral-300">
              ← Cockpit Clínico
            </a>
            <a href="/desk/studio" class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-neutral-950 text-xs font-bold transition">
              Brand Identity Studio →
            </a>
          </div>
        </header>

        {/* 3 Pillars Grid */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="border border-neutral-800 rounded-xl p-6 bg-neutral-900/50 space-y-3">
            <span class="text-xs font-mono font-bold text-amber-400">01. ARQUETIPO SOLAR / BAZI</span>
            <h3 class="text-lg font-bold text-white">Geng Yang Metal &middot; Capricornio</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Day Master de precisión y filo estratégico. Estructura de alta tenacidad con Sol tropical en Casa 10 de autoridad soberana.
            </p>
          </div>

          <div class="border border-neutral-800 rounded-xl p-6 bg-neutral-900/50 space-y-3">
            <span class="text-xs font-mono font-bold text-cyan-400">02. HUMAN DESIGN BLUEPRINT</span>
            <h3 class="text-lg font-bold text-white">Manifesting Generator 3/5</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Autoridad Emocional con Canal 34-20 del Carisma. Proyección de liderazgo hereje-práctico ante crisis del mercado.
            </p>
          </div>

          <div class="border border-neutral-800 rounded-xl p-6 bg-neutral-900/50 space-y-3">
            <span class="text-xs font-mono font-bold text-rose-400">03. TIKKUN DE RAV BERG</span>
            <h3 class="text-lg font-bold text-white">Nodo Norte en Leo (Casa 11)</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Superar el refugio intelectual acuario para asumir visibilidad regia y generosidad de corazón en la facilitación comunitaria.
            </p>
          </div>
        </div>

        {/* Lakehouse Status & Trigger */}
        <section class="border border-neutral-800 rounded-xl p-6 bg-neutral-900/30 space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base font-bold text-white">Motor de Extracción Universal (15 Shards)</h2>
              <p class="text-xs text-neutral-400">Ingestión atómica de datos astronómicos y metafísicos a PostgreSQL 18.</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              Seguro: dryRun=true (Cero Costo)
            </span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 pt-2">
            <div class="p-3 rounded-lg bg-neutral-950 border border-neutral-800 text-center">
              <div class="text-[10px] text-neutral-500 font-mono">SHARD 1</div>
              <div class="text-xs font-bold text-neutral-200 mt-1">Tropical Placidus</div>
            </div>
            <div class="p-3 rounded-lg bg-neutral-950 border border-neutral-800 text-center">
              <div class="text-[10px] text-neutral-500 font-mono">SHARD 2</div>
              <div class="text-xs font-bold text-neutral-200 mt-1">Sideral Fagan-B.</div>
            </div>
            <div class="p-3 rounded-lg bg-neutral-950 border border-neutral-800 text-center">
              <div class="text-[10px] text-neutral-500 font-mono">SHARD 3-4</div>
              <div class="text-xs font-bold text-neutral-200 mt-1">Jyotish & Dashas</div>
            </div>
            <div class="p-3 rounded-lg bg-neutral-950 border border-neutral-800 text-center">
              <div class="text-[10px] text-neutral-500 font-mono">SHARD 5-6</div>
              <div class="text-xs font-bold text-neutral-200 mt-1">BaZi & ZiWei</div>
            </div>
            <div class="p-3 rounded-lg bg-neutral-950 border border-neutral-800 text-center">
              <div class="text-[10px] text-neutral-500 font-mono">SHARD 7-8</div>
              <div class="text-xs font-bold text-neutral-200 mt-1">Kabbalah & Zmanim</div>
            </div>
          </div>
        </section>
      </div>
    ) : (
      <div class="min-h-screen flex items-center justify-center bg-neutral-950 p-6 font-mono">
        <div class="max-w-md w-full bg-neutral-900 border border-neutral-800 rounded-xl p-8 text-center space-y-4">
          <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
          <h2 class="text-lg font-bold text-white">Gabinete Privado &middot; Fase 0</h2>
          <p class="text-xs text-neutral-400">Ingresá tu clave maestra para acceder a la constitución ontológica.</p>
          <form method="POST" action="/api/coach/auth" class="space-y-3 pt-2">
            <input
              type="password"
              name="masterKey"
              placeholder="COACH_MASTER_KEY"
              required
              class="w-full bg-neutral-950 border border-neutral-800 rounded-lg px-4 py-2 text-xs text-white text-center focus:outline-none focus:border-amber-500"
            />
            <button
              type="submit"
              class="w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-xs font-bold text-neutral-950 rounded-lg transition-colors cursor-pointer"
            >
              Autenticar
            </button>
          </form>
        </div>
      </div>
    )
  }
</BaseLayout>
